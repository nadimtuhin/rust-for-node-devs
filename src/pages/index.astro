---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import LessonDetail from '../components/LessonDetail.astro';
import Playground from '../components/Playground.astro';
import { chaptersData } from '../data/chapters';
import { chapterInsights } from '../data/chapterInsights';

const initialKey = 'basic_vars';
const initialChapter = chaptersData[initialKey];
---

<Layout 
  title="Rust for Node.js Devs | Interactive GitBook & Live Compiler"
  description="Master systems programming in Rust tailored for Node.js & TypeScript engineers. 56 interactive lessons, side-by-side JS comparisons, and live in-browser compiler."
>
  <Header />

  <main class="studio-main-3col" id="main-content" role="main">
    <div id="sidebarOverlay" class="sidebar-backdrop" onclick="toggleSidebar(false)" aria-hidden="true"></div>

    <Sidebar activeKey={initialKey} />

    <section class="lesson-column" aria-label="Lesson Details and Architecture">
      <LessonDetail chapterKey={initialKey} />
    </section>

    <Playground chapterKey={initialKey} />
  </main>

  <script is:inline src="/chapters-data.js"></script>
  <script is:inline src="/chapter-insights.js"></script>

  <script is:inline>
    let activeKey = 'basic_vars';
    let editor = null;

    // Mobile Sidebar Drawer Toggle
    function toggleSidebar(forceState) {
      const sidebar = document.getElementById('chaptersList');
      const overlay = document.getElementById('sidebarOverlay');
      if (!sidebar) return;

      const isOpening = forceState !== undefined ? forceState : !sidebar.classList.contains('mobile-open');

      if (isOpening) {
        sidebar.classList.add('mobile-open');
        if (overlay) overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      } else {
        sidebar.classList.remove('mobile-open');
        if (overlay) overlay.classList.remove('active');
        document.body.style.overflow = '';
      }
    }
    window.toggleSidebar = toggleSidebar;

    window.addEventListener('DOMContentLoaded', () => {
      const area = document.getElementById('codeArea');
      if (area && window.CodeMirror) {
        editor = CodeMirror.fromTextArea(area, {
          mode: 'rust',
          theme: 'dracula',
          lineNumbers: true,
          indentUnit: 4,
          tabSize: 4,
          lineWrapping: true,
          viewportMargin: 20,
      extraKeys: {
        "Cmd-Enter": function() { executeRustCode(); },
        "Ctrl-Enter": function() { executeRustCode(); },
        "Cmd-K": function() {
          if (window.innerWidth <= 1024) toggleSidebar(true);
          const input = document.getElementById('lessonSearchInput');
          if (input) { input.focus(); input.select(); }
        },
        "Ctrl-K": function() {
          if (window.innerWidth <= 1024) toggleSidebar(true);
          const input = document.getElementById('lessonSearchInput');
          if (input) { input.focus(); input.select(); }
        }
      }
        });
      }

      const params = new URLSearchParams(window.location.search);
      const requested = params.get('chapter');
      if (requested && window.chaptersData && window.chaptersData[requested]) {
        selectChapter(requested, false);
      } else {
        selectChapter('basic_vars', false);
      }
    });

    function selectChapter(key, pushHistory = true) {
      if (!window.chaptersData || !window.chaptersData[key]) return;
      activeKey = key;
      const data = window.chaptersData[key];
      const insight = (window.chapterInsights && window.chapterInsights[key]) || {};

      document.querySelectorAll('.chapter-nav-item').forEach(item => {
        const itemKey = item.getAttribute('data-id');
        const isActive = itemKey === key;
        item.classList.toggle('active', isActive);
        if (isActive) {
          item.setAttribute('aria-current', 'true');
        } else {
          item.removeAttribute('aria-current');
        }
      });

      const partTag = document.getElementById('detailPartTag');
      if (partTag) partTag.innerText = data.part;

      const idEl = document.getElementById('detailId');
      if (idEl) idEl.innerText = '#' + data.num;

      const titleEl = document.getElementById('detailTitle');
      if (titleEl) titleEl.innerText = data.title;

      const descEl = document.getElementById('detailDesc');
      if (descEl) descEl.innerText = data.desc;

      const nodeCodeEl = document.getElementById('detailNodeCode');
      if (nodeCodeEl) {
        nodeCodeEl.innerHTML = `<code>${data.nodeCode.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code>`;
      }

      const whyEl = document.getElementById('detailRustWhy');
      if (whyEl) whyEl.innerText = data.why;

      const proTipEl = document.getElementById('detailInsightProTip');
      if (proTipEl) proTipEl.innerText = insight.proTip || '';

      const footgunEl = document.getElementById('detailInsightFootgun');
      if (footgunEl) footgunEl.innerText = insight.footgun || '';

      const archNoteEl = document.getElementById('detailInsightArchNote');
      if (archNoteEl) archNoteEl.innerText = insight.archNote || '';

      const fileTab = document.getElementById('editorCurrentFile');
      if (fileTab) fileTab.innerText = `📄 main.rs — ${data.title}`;

      if (editor) {
        editor.setValue(data.code);
      }

      updateStatus('Ready', 'ready');
      const consoleArea = document.getElementById('consoleArea');
      if (consoleArea) {
        consoleArea.className = 'console-body';
        consoleArea.textContent = '// Hit "Run Code" (or ⌘+Enter) to compile and execute on Rust Playground!';
      }

      if (window.innerWidth <= 1024) {
        toggleSidebar(false);
      }

      if (pushHistory && window.history && window.history.pushState) {
        const newUrl = window.location.pathname + '?chapter=' + encodeURIComponent(key);
        window.history.pushState({ chapter: key }, '', newUrl);
      }
    }

    function navigateLesson(direction) {
      if (!window.chaptersData) return;
      const keys = Object.keys(window.chaptersData);
      const currentIndex = keys.indexOf(activeKey);
      if (currentIndex === -1) return;

      const nextIndex = currentIndex + direction;
      if (nextIndex >= 0 && nextIndex < keys.length) {
        selectChapter(keys[nextIndex]);
      }
    }

    function filterLessons(query) {
      const q = query.toLowerCase().trim();
      const items = document.querySelectorAll('.chapter-nav-item');
      const clearBtn = document.getElementById('clearSearchBtn');
      const notice = document.getElementById('noResultsNotice');
      let visibleCount = 0;

      if (clearBtn) clearBtn.style.display = q ? 'inline-flex' : 'none';

      items.forEach(item => {
        const key = item.getAttribute('data-id');
        const data = window.chaptersData ? window.chaptersData[key] : null;
        if (!data) return;

        const match = data.title.toLowerCase().includes(q) ||
                      data.num.toLowerCase().includes(q) ||
                      data.part.toLowerCase().includes(q) ||
                      data.desc.toLowerCase().includes(q);

        item.style.display = match ? 'flex' : 'none';
        if (match) visibleCount++;
      });

      // Hide empty part headers
      document.querySelectorAll('.sidebar-part-group').forEach(group => {
        const hasVisible = Array.from(group.querySelectorAll('.chapter-nav-item'))
          .some(item => (item as HTMLElement).style.display !== 'none');
        (group as HTMLElement).style.display = hasVisible ? 'block' : 'none';
      });

      if (notice) notice.style.display = visibleCount === 0 ? 'block' : 'none';
      const badge = document.getElementById('sidebarCountBadge');
      if (badge) badge.innerText = q ? `${visibleCount} Found` : '56 Chapters';
    }

    function clearLessonSearch() {
      const input = document.getElementById('lessonSearchInput');
      if (input) {
        input.value = '';
        filterLessons('');
        input.focus();
      }
    }

    function copyNodeSnippet() {
      const nodeEl = document.getElementById('detailNodeCode');
      if (nodeEl) {
        navigator.clipboard.writeText(nodeEl.innerText).then(() => {
          updateStatus('Copied JS Snippet', 'ready');
        });
      }
    }

    function copyEditorCode() {
      const code = editor ? editor.getValue() : '';
      navigator.clipboard.writeText(code).then(() => {
        updateStatus('Copied Rust Code', 'ready');
      });
    }

    function resetEditorCode() {
      if (editor && window.chaptersData && window.chaptersData[activeKey]) {
        editor.setValue(window.chaptersData[activeKey].code);
      }
    }

    function clearConsole() {
      const c = document.getElementById('consoleArea');
      if (c) c.innerText = '';
      updateStatus('Ready', 'ready');
    }

    function copyConsoleOutput() {
      const c = document.getElementById('consoleArea');
      if (c) {
        navigator.clipboard.writeText(c.innerText).then(() => {
          updateStatus('Copied Terminal Output', 'ready');
        });
      }
    }

    function updateStatus(text, type) {
      const tag = document.getElementById('statusTag');
      const dot = document.getElementById('statusDot');
      if (tag) {
        tag.innerText = text;
        tag.className = 'status-pill ' + (type || 'ready');
      }
      if (dot) {
        dot.className = 'status-dot ' + (type === 'error' ? 'error' : (type === 'running' ? 'compiling' : ''));
      }
    }

    
    function ansiToHtml(text) {
      if (!text) return '';
      return text
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/\x1b\[(?:1;31|31(?:;1)?|91)m/g, '<span style="color:#f87171;font-weight:bold;">')
        .replace(/\x1b\[(?:1;33|33(?:;1)?|93)m/g, '<span style="color:#fbbf24;font-weight:bold;">')
        .replace(/\x1b\[(?:1;32|32(?:;1)?|92)m/g, '<span style="color:#4ade80;font-weight:bold;">')
        .replace(/\x1b\[(?:1;36|36(?:;1)?|96)m/g, '<span style="color:#38bdf8;font-weight:bold;">')
        .replace(/\x1b\[(?:1;34|34(?:;1)?|94)m/g, '<span style="color:#60a5fa;font-weight:bold;">')
        .replace(/\x1b\[1m/g, '<span style="font-weight:bold;color:#f8fafc;">')
        .replace(/\x1b\[4m/g, '<span style="text-decoration:underline;">')
        .replace(/\x1b\[0m/g, '</span>')
        .replace(/\x1b\[[0-9;]*m/g, '');
    }

    async function executeRustCode() {
      const code = editor ? editor.getValue() : (window.chaptersData[activeKey] ? window.chaptersData[activeKey].code : '');
      const consoleArea = document.getElementById('consoleArea');
      const runBtn = document.getElementById('runBtn');
      const statusDot = document.getElementById('statusDot');
      const statusTag = document.getElementById('statusTag');
      const statusLatency = document.getElementById('statusLatency');

      if (runBtn) runBtn.disabled = true;
      if (statusDot) statusDot.className = 'status-dot compiling';
      if (statusTag) {
        statusTag.className = 'status-pill running';
        statusTag.innerText = 'Compiling...';
      }
      if (statusLatency) statusLatency.innerText = '';

      if (consoleArea) {
        consoleArea.className = 'console-body';
        consoleArea.textContent = '⏳ Compiling with rustc on play.rust-lang.org...';
      }

      const startTime = performance.now();

      try {
        const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 20000);
      const response = await fetch('https://play.rust-lang.org/execute', {
        signal: controller.signal,
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            channel: 'stable',
            mode: 'debug',
            edition: '2021',
            crateType: 'bin',
            tests: false,
            code: code
          })
        });

        const elapsed = Math.round(performance.now() - startTime);
        if (statusLatency) statusLatency.innerText = `${elapsed}ms`;

        if (!response.ok) {
          throw new Error(`Compiler returned HTTP ${response.status}`);
        }

        clearTimeout(timeoutId);
      const data = await response.json();

        if (!data.success) {
          consoleArea.className = 'console-body is-error';
          consoleArea.innerHTML = '<span style="color:#f87171;font-weight:bold;">❌ Compile Error:</span><br/><br/>' + ansiToHtml(data.stderr || 'Build failed.');
          if (statusDot) statusDot.className = 'status-dot error';
          if (statusTag) {
            statusTag.className = 'status-pill error';
            statusTag.innerText = 'Error';
          }
        } else {
          let outputText = '';
          if (data.stdout && data.stdout.trim().length > 0) {
            outputText = data.stdout;
          } else {
            outputText = '✓ Binary executed successfully with exit code 0 (no stdout output).\n' + (data.stderr || '');
          }
          consoleArea.className = 'console-body';
          consoleArea.textContent = outputText;
          if (statusDot) statusDot.className = 'status-dot';
          if (statusTag) {
            statusTag.className = 'status-pill ready';
            statusTag.innerText = `Exit 0 • ${elapsed}ms`;
          }
        }
      } catch (err) {
      if (err.name === 'AbortError') {
        const latency = Math.round(performance.now() - startTime);
        if (statusLatency) statusLatency.innerText = latency + 'ms';
        if (statusDot) statusDot.className = 'status-dot error';
        if (statusTag) statusTag.innerText = 'TIMEOUT (20s)';
        if (consoleArea) {
          consoleArea.innerHTML = '';
          const errPre = document.createElement('pre');
          errPre.className = 'ansi-err';
          errPre.textContent = '⏱️ Execution Timed Out: The Rust Playground did not respond within 20 seconds. If running an infinite loop or heavy compilation, terminate and simplify the snippet.';
          consoleArea.appendChild(errPre);
        }
        if (runBtn) {
          runBtn.disabled = false;
          runBtn.innerHTML = '<span>⚡</span><span>Run Rust (⌘↵)</span>';
        }
        return;
      }
        const elapsed = Math.round(performance.now() - startTime);
        if (statusLatency) statusLatency.innerText = `${elapsed}ms`;
        if (consoleArea) {
          consoleArea.className = 'console-body is-error';
          consoleArea.textContent = '⚠️ Request Failed:\n' + err.message;
        }
        if (statusDot) statusDot.className = 'status-dot error';
        if (statusTag) {
          statusTag.className = 'status-pill error';
          statusTag.innerText = 'Failed';
        }
      } finally {
        if (runBtn) runBtn.disabled = false;
      }
    }

    window.addEventListener('popstate', (e) => {
      const key = (e.state && e.state.chapter) || new URLSearchParams(window.location.search).get('chapter') || 'basic_vars';
      if (window.chaptersData && window.chaptersData[key]) {
        selectChapter(key, false);
      }
    });

    document.addEventListener('keydown', function(e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        executeRustCode();
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        const input = document.getElementById('lessonSearchInput');
        if (input) {
          if (window.innerWidth <= 860) toggleSidebar(true);
          input.focus();
          input.select();
        }
      }
      if (e.key === 'Escape') {
        const sidebar = document.getElementById('chaptersList');
        if (sidebar && sidebar.classList.contains('mobile-open')) {
          toggleSidebar(false);
          const expandBtn = document.getElementById('sidebarExpandBtn');
          if (expandBtn) expandBtn.focus();
        }
      }
    });

    window.selectChapter = selectChapter;
    window.navigateLesson = navigateLesson;
    window.filterLessons = filterLessons;
    window.clearLessonSearch = clearLessonSearch;
    window.copyNodeSnippet = copyNodeSnippet;
    window.copyEditorCode = copyEditorCode;
    window.resetEditorCode = resetEditorCode;
    window.clearConsole = clearConsole;
    window.copyConsoleOutput = copyConsoleOutput;
    window.executeRustCode = executeRustCode;
  </script>
</Layout>
