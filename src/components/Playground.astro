---
// Interactive Rust Playground Component
interface Props {
  chapterKey?: string;
}
const { chapterKey = 'basic_vars' } = Astro.props;
import { chaptersData } from '../data/chapters';
const chapter = chaptersData[chapterKey] || chaptersData['basic_vars'];
---
<div class="playground-column" id="playgroundSection" role="region" aria-label="Interactive Rust Code Playground">
  <div class="editor-toolbar" role="toolbar" aria-label="Code Editor Toolbar">
    <div class="editor-tab-group">
      <div class="editor-tab" id="editorCurrentFile" aria-label={`Active file: main.rs — ${chapter.title}`}>main.rs</div>
    </div>
    <div class="editor-actions">
      <button id="copyBtn" class="tool-btn" onclick="copyEditorCode()" aria-label="Copy Rust code to clipboard">Copy</button>
      <button id="resetBtn" class="tool-btn" onclick="resetEditorCode()" aria-label="Reset Rust code to chapter default">Reset</button>
      <button id="runBtn" class="btn-run" onclick="executeRustCode()" aria-label="Compile and run Rust code (Keyboard shortcut: Command + Enter)">
        <span>Run</span>
        <span class="btn-shortcut" aria-hidden="true">⌘⏎</span>
      </button>
    </div>
  </div>

  <div class="editor-container" aria-label="CodeMirror Rust Editor">
    <textarea id="codeArea" aria-label="Rust Source Code Editor">{chapter.code}</textarea>
  </div>

  <div class="console-panel" role="region" aria-label="Terminal Execution Output">
    <div class="console-header">
      <span class="console-title">Output</span>
      <div class="console-status-group">
        <span class="status-dot" id="statusDot" aria-hidden="true"></span>
        <span id="statusLatency" style="font-size:0.7rem; color:var(--console-muted); font-family:var(--font-mono, monospace);" aria-label="Execution time"></span>
        <span id="statusTag" class="status-pill ready" role="status" aria-label="Execution status">Ready</span>
        <button class="copy-snippet-btn" onclick="clearConsole()" aria-label="Clear terminal output">Clear</button>
        <button class="copy-snippet-btn" onclick="copyConsoleOutput()" aria-label="Copy terminal output to clipboard">Copy</button>
      </div>
    </div>
    <div id="consoleArea" class="console-body" role="status" aria-live="polite" aria-atomic="true">// Hit "Run" (or ⌘+Enter) to compile and execute on Rust Playground</div>
  </div>
</div>
