<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#b7410e" />
      <stop offset="100%" stop-color="#ea580c" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)" />

  <!-- Accent top bar -->
  <rect width="1200" height="12" fill="url(#accent)" />

  <!-- Badge -->
  <g transform="translate(100, 110)">
    <rect width="360" height="42" rx="21" fill="#ffedd5" />
    <text x="180" y="27" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="16" font-weight="700" fill="#c2410c" text-anchor="middle">THE INTERACTIVE MASTERCLASS STUDIO</text>
  </g>

  <!-- Title -->
  <text x="100" y="240" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="64" font-weight="900" fill="#ffffff" letter-spacing="-1">
    Rust for Node.js Devs
  </text>

  <!-- Subtitle -->
  <text x="100" y="315" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="28" font-weight="400" fill="#94a3b8">
    From Single-Threaded V8 to Fearless Concurrency &amp; Systems Speed
  </text>

  <!-- Features Grid -->
  <g transform="translate(100, 410)">
    <!-- Pill 1 -->
    <rect x="0" y="0" width="220" height="64" rx="12" fill="#1e293b" stroke="#334155" stroke-width="2" />
    <text x="24" y="38" font-family="monospace" font-size="22" font-weight="700" fill="#b7410e">56 Chapters</text>

    <!-- Pill 2 -->
    <rect x="250" y="0" width="260" height="64" rx="12" fill="#1e293b" stroke="#334155" stroke-width="2" />
    <text x="274" y="38" font-family="monospace" font-size="22" font-weight="700" fill="#38bdf8">Live Compiler</text>

    <!-- Pill 3 -->
    <rect x="540" y="0" width="260" height="64" rx="12" fill="#1e293b" stroke="#334155" stroke-width="2" />
    <text x="564" y="38" font-family="monospace" font-size="22" font-weight="700" fill="#4ade80">13 Appendices</text>
  </g>

  <!-- Mascot Crab Emoji -->
  <text x="1040" y="260" font-size="120" text-anchor="middle">🦀</text>
</svg>
