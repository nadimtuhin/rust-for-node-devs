---
// Lesson Detail Component for Rust
interface Props {
  chapterKey?: string;
}
const { chapterKey = 'basic_vars' } = Astro.props;
import { chaptersData } from '../data/chapters';
import { chapterInsights } from '../data/chapterInsights';
import { highlightJS } from '../utils/highlight';
import { relatedAppendices } from '../data/crossLinks';

const chapter = chaptersData[chapterKey] || chaptersData['basic_vars'];
const insight = chapterInsights[chapterKey] || chapterInsights['basic_vars'];
const highlightedNodeCode = highlightJS(chapter.nodeCode);
const appendixLinks = relatedAppendices(chaptersData[chapterKey] ? chapterKey : 'basic_vars');

const keys = Object.keys(chaptersData);
const currentIndex = keys.indexOf(chapterKey);
const hasPrev = currentIndex > 0;
const hasNext = currentIndex !== -1 && currentIndex < keys.length - 1;
const prevTitle = hasPrev ? chaptersData[keys[currentIndex - 1]].title : '';
const nextTitle = hasNext ? chaptersData[keys[currentIndex + 1]].title : '';
---
<article class="lesson-detail-panel" id="detailPanel" aria-labelledby="detailTitle">
  <div class="detail-badge-row gitbook-breadcrumb">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <button id="sidebarExpandBtn" class="sidebar-expand-btn" onclick="toggleSidebar()" aria-label="Toggle Table of Contents sidebar" title="Toggle Table of Contents">Menu</button>
      <span class="part-tag" id="detailPartTag">{chapter.part}</span>
    </div>
    <span class="gitbook-chapter-id" id="detailId">#{chapter.num}</span>
  </div>

  <h1 class="lesson-title" id="detailTitle">{chapter.title}</h1>
  <p class="lesson-desc" id="detailDesc">
    {chapter.desc}
  </p>

  <div class="node-box-wrap gitbook-code-comparison" role="region" aria-label="Node.js Code Comparison">
    <div class="node-header-row">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span class="node-lang-pill">Node.js / TypeScript Equivalent</span>
        <span class="node-file-tag">index.ts</span>
      </div>
      <button id="copyNodeBtn" class="copy-snippet-btn" onclick="copyNodeSnippet()" aria-label="Copy Node.js snippet to clipboard">Copy</button>
    </div>
    <pre class="node-code" id="detailNodeCode" tabindex="0" role="region" aria-label="Node.js code example"><code set:html={highlightedNodeCode}></code></pre>
  </div>

  <div class="rust-why-box" role="region" aria-label="Rust Mental Model Rationale">
    <div class="rust-why-title">The Rust Mental Model</div>
    <p class="rust-why-desc" id="detailRustWhy">
      {chapter.why}
    </p>
  </div>

  <!-- Deep Architecture Breakdown -->
  <section class="chapter-insight-section" aria-label="Architectural Paradigm Comparison">
    <div class="insight-card">
      <h2 class="insight-heading">Systems Deep Dive</h2>
      <dl class="insight-definition-list">
        <dt class="insight-term pro-tip">Pro Tip</dt>
        <dd class="insight-desc" id="detailInsightProTip">{insight.proTip}</dd>
        
        <dt class="insight-term footgun">Footgun</dt>
        <dd class="insight-desc" id="detailInsightFootgun">{insight.footgun}</dd>

        <dt class="insight-term arch-note">Arch Note</dt>
        <dd class="insight-desc" id="detailInsightArchNote">{insight.archNote}</dd>
      </dl>
    </div>
  </section>

  <nav class="related-appendices" aria-labelledby="relatedAppendicesHeading">
    <h2 class="insight-heading" id="relatedAppendicesHeading">Go deeper in the appendices</h2>
    <ul class="related-appendices-list" id="detailRelatedAppendices">
      {appendixLinks.map(link => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
</article>

<style>
  .related-appendices {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .related-appendices-list {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.84rem;
    line-height: 1.7;
  }

  /* :global because the home studio rebuilds these links client-side on lesson switch. */
  .related-appendices-list :global(a) {
    color: var(--rust-primary);
    font-weight: 600;
  }

  .chapter-insight-section {
    margin-top: 0.25rem;
  }

  .insight-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.125rem 1.25rem;
  }

  .insight-heading {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.875rem;
    letter-spacing: -0.015em;
  }

  .insight-definition-list {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 0.625rem 0.875rem;
    margin: 0;
    align-items: baseline;
  }

  @media (max-width: 640px) {
    .insight-definition-list {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  .insight-term {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .insight-term.pro-tip {
    color: #0284c7;
  }

  .insight-term.footgun {
    color: #dc2626;
  }

  .insight-term.arch-note {
    color: var(--rust-primary);
  }

  .insight-desc {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.62;
    color: var(--text-body);
  }
</style>
