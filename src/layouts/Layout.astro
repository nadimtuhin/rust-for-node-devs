---
interface Props {
  title?: string;
  description?: string;
  heading?: string;
  canonicalPath?: string;
  breadcrumbs?: { name: string; item: string }[];
  includeEditor?: boolean;
}

const {
  title = "Rust for Node.js Devs | Interactive GitBook & Live Compiler",
  description = "Learn Rust with live in-browser Rust Playground compiler, progressive lessons, side-by-side Node.js/TypeScript comparisons, and production systems architecture guides.",
  heading,
  canonicalPath = Astro.url.pathname,
  breadcrumbs = [],
  includeEditor = true
} = Astro.props;

import '../styles/global.css';

const siteOrigin = "https://rust-for-node-devs.vercel.app";
const cleanPath = canonicalPath.replace(/\/+$/, '') || '';
const canonicalUrl = `${siteOrigin}${cleanPath}`;
const ogImageUrl = `${siteOrigin}/og-image.png`;
const ogImageAlt = "Rust for Node.js Developers - Interactive Masterclass Studio";
const themeColor = "#b7410e";
const author = { "@type": "Person", "@id": `${siteOrigin}/#author`, "name": "Nadim Tuhin", "url": "https://github.com/nadimtuhin" };
// 56 lessons at ~30 min each with their live-compiler exercises, plus the 14 appendices.
const courseWorkload = "PT35H";

// Every page except the home page and the curriculum index is either a lesson or an appendix.
const curriculumPath = "/chapters";
const isLesson = cleanPath.startsWith('/chapter/');
const isAppendix = !isLesson && cleanPath !== '' && cleanPath !== curriculumPath;
const isArticle = isLesson || isAppendix;
const pageHeading = heading ?? title.split('|')[0].trim();

const defaultBreadcrumbs = [
  { name: "Home", item: siteOrigin },
  ...(isArticle ? [{ name: "Curriculum", item: `${siteOrigin}${curriculumPath}` }] : []),
  ...(cleanPath ? [{ name: pageHeading, item: canonicalUrl }] : [])
];
const activeBreadcrumbs = breadcrumbs.length > 0 ? breadcrumbs : defaultBreadcrumbs;

const graphNodes: any[] = [
  {
    "@type": "WebSite",
    "@id": `${siteOrigin}/#website`,
    "url": siteOrigin,
    "name": "Rust for Node.js Developers Masterclass Studio",
    "description": "Interactive Rust learning platform and Rosetta Stone for Node.js and TypeScript developers.",
    "inLanguage": "en-US",
    "publisher": author
  },
  {
    "@type": "Course",
    "@id": `${siteOrigin}/#course`,
    "name": "Rust for Node.js & TypeScript Developers",
    "description": "Comprehensive transition guide from single-threaded V8 JavaScript to fearless concurrency, memory safety without GC, and high-performance systems programming in Rust.",
    "url": `${siteOrigin}${curriculumPath}`,
    "inLanguage": "en-US",
    "isAccessibleForFree": true,
    "educationalLevel": "Intermediate",
    "teaches": ["Rust ownership and borrowing", "Async Rust with Tokio", "Cargo and crates", "Production Rust web services"],
    "coursePrerequisites": "Working knowledge of JavaScript or TypeScript on Node.js",
    "image": ogImageUrl,
    "timeRequired": courseWorkload,
    "provider": author,
    "publisher": author,
    "offers": {
      "@type": "Offer",
      "category": "Free",
      "price": 0,
      "priceCurrency": "USD"
    },
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseMode": "Online",
      "courseWorkload": courseWorkload,
      "instructor": author
    }
  }
];

if (isArticle) {
  graphNodes.push({
    "@type": isLesson ? ["TechArticle", "LearningResource"] : "TechArticle",
    "@id": `${canonicalUrl}#article`,
    "headline": pageHeading,
    "name": title,
    "description": description,
    "url": canonicalUrl,
    "image": ogImageUrl,
    "inLanguage": "en-US",
    "author": author,
    "publisher": author,
    "mainEntityOfPage": canonicalUrl,
    "isPartOf": { "@id": `${siteOrigin}/#course` },
    ...(isLesson && {
      "learningResourceType": "Interactive Tutorial",
      "educationalLevel": "Intermediate",
      "isAccessibleForFree": true
    })
  });
}

if (activeBreadcrumbs.length > 1) {
  graphNodes.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumbs`,
    "itemListElement": activeBreadcrumbs.map((bc, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": bc.name,
      "item": bc.item
    }))
  });
}

const structuredData = {
  "@context": "https://schema.org",
  "@graph": graphNodes
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nadim Tuhin" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable course index" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Rust for Node.js Developers" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="twitter:creator" content="@nadimtuhin" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- CodeMirror Assets via CDN -->
    {includeEditor && (
      <>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css" />
        <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
        <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/mode/simple.min.js"></script>
        <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/rust/rust.min.js"></script>
        <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>
      </>
    )}

    <!-- Global Syntax Highlighting Runtime -->
    <script is:inline src="/highlight.js"></script>

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    {activeBreadcrumbs.length > 1 && (
      <nav aria-label="Breadcrumb" class="sr-only">
        <ol>
          {activeBreadcrumbs.map((bc, idx) => (
            <li>
              <a href={bc.item} aria-current={idx === activeBreadcrumbs.length - 1 ? "page" : undefined}>{bc.name}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}
    <slot />
  </body>
</html>