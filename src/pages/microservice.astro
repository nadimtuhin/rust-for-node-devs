---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ViewComponent from '../components/views/MicroserviceView.astro';
import FoundationalLessons from '../components/FoundationalLessons.astro';
---

<Layout title="Production Axum Microservice | Rust for Node Devs" description="Full side-by-side comparison of an Express/Mongoose microservice re-architected in Axum and SQLx.">
  <Header />
  <main id="main-content" role="main" style="min-height: calc(100vh - 54px); overflow-y: auto;">
    <ViewComponent />
    <FoundationalLessons appendixSlug="microservice" />
  </main>
</Layout>
